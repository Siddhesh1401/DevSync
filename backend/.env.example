PORT=3001
NODE_ENV=development

# Supabase (get these from your Supabase project settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GitHub webhook secret (you'll create this when setting up webhooks in Phase 3)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Email (optional in Phase 1, required in Phase 4)
SENDGRID_API_KEY=optional_for_now

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
