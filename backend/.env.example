PORT=3001
NODE_ENV=development

# Supabase (get these from your Supabase project settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# GitHub webhook secret (you'll create this when setting up webhooks in Phase 3)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Email (required for invites and notifications)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=your_gmail_app_password_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Public backend URL used in generated webhook instructions
BACKEND_PUBLIC_URL=http://localhost:3001
